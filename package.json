{
  "name": "claude-glass",
  "version": "1.0.0",
  "description": "Glassmorphism desktop widget for monitoring Claude usage on Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:parity && npm run test:smoke",
    "test:parity": "node test/bridge-parity.js",
    "test:smoke": "node test/smoke/run.js",
    "icons": "python build/make-icons.py",
    "dist:win": "npx electron-builder --win"
  },
  "author": "Vitória Silva — Data System",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.datasystem.claude-glass",
    "productName": "Claude Glass",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "usage.js",
      "auth.js",
      "taskbar.js",
      "config.json",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Glass",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Claude-Glass-Setup-${version}.${ext}"
    }
  }
}
